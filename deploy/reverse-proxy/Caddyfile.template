{
    admin off
}

{$AIWORLD_DOMAIN} {
    encode zstd gzip

    @metrics path /metrics
    respond @metrics 404

    @setup_denied {
        path /setup /api/setup/* /api/persona/*
        not remote_ip 127.0.0.1 ::1 {$AIWORLD_ADMIN_CIDR}
    }
    respond @setup_denied 403

    @setup_path path /setup /api/setup/* /api/persona/*
    handle @setup_path {
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:8080
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        -Server
    }

    handle /assets/* {
        header Cache-Control "public, max-age=604800, immutable"
        reverse_proxy 127.0.0.1:8080
    }

    handle /static/* {
        header Cache-Control "public, max-age=604800"
        reverse_proxy 127.0.0.1:8080
    }

    reverse_proxy 127.0.0.1:8080
}
