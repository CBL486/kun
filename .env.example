# 仅用于本地开发；生产必须使用 deploy/windows/production.env.example
# 并将数据目录设置为 C:\AIWorld\data 下的 release 外部绝对路径。
AIWORLD_ENVIRONMENT=development
AIWORLD_DATABASE_URL=sqlite+aiosqlite:///./data/local.sqlite3
AIWORLD_PRODUCT_DATABASE_URL=sqlite:///./data/local.sqlite3
AIWORLD_LOG_LEVEL=INFO
AIWORLD_SETUP_DIRECTORY=./data/setup
AIWORLD_ENFORCE_SETUP_ACL=true
AIWORLD_PERSONA_DIRECTORY=./data/persona
AIWORLD_WORLD_CLOCK_DIRECTORY=./data/world
AIWORLD_WORLD_TICK_MINUTES=10
AIWORLD_LLM_PROVIDER=deepseek
AIWORLD_LLM_BASE_URL=https://api.deepseek.com
AIWORLD_LLM_MODEL=deepseek-flash
AIWORLD_LLM_API_KEY=
AIWORLD_LLM_API_KEY_FILE=
