          "current_location_id",
          "current_location_name"
        ],
        "title": "WorldInfo",
        "type": "object"
      },
      "WorldResponse": {
        "properties": {
          "locations": {
            "items": {
              "$ref": "#/components/schemas/PublicLocation"
            },
            "title": "Locations",
            "type": "array"
          },
          "observer_capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Observer Capabilities",
            "type": "array"
          },
          "people": {
            "items": {
              "$ref": "#/components/schemas/PublicPerson"
            },
            "title": "People",
            "type": "array"
          },
          "schema_version": {
            "const": "rpg-public-world-v1",
            "title": "Schema Version",
            "type": "string"
          },
          "world": {
            "$ref": "#/components/schemas/WorldInfo"
          }
        },
        "required": [
          "schema_version",
          "world",
          "locations",
          "people",
          "observer_capabilities"
        ],
        "title": "WorldResponse",
        "type": "object"
      }
    }
  },
